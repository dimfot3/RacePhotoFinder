# Project data (keep the directory itself in Git)
/datasets/*
!/datasets/.gitkeep

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments and locally installed dependencies
.venv/
venv/
env/
.env
.env.*
.deps/

# Editors and operating systems
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local Codex/workspace metadata
/.agents/
/.aws/
/.codex/

# Logs and temporary files
*.log
*.tmp
*.temp

# Build and packaging output
build/
dist/
*.egg-info/

# Local databases and generated thumbnails
*.db
*.db-shm
*.db-wal
thumbnails/

# Generated ML artifacts
**/runs/*
**/.yolo_dataset/
**/evaluation_results.json

# Keep only the deployable fine-tuned bib checkpoint from training runs.
!/bib_detection/runs/bib_yolo26s/
/bib_detection/runs/bib_yolo26s/*
!/bib_detection/runs/bib_yolo26s/weights/
/bib_detection/runs/bib_yolo26s/weights/*
!/bib_detection/runs/bib_yolo26s/weights/best.pt

# InsightFace public pretrained models are non-commercial research assets.
# Download them from the official model zoo after accepting its terms.
/face_detection/weights/*
!/face_detection/weights/.gitkeep
/face_matching/weights/*
!/face_matching/weights/.gitkeep

